<div class="d2 d2-roll-dialog">
  <div class="form-group">
    <label>{{localize "D2.Oracle.question"}}</label>
    <input type="text" name="question" placeholder="{{localize 'D2.Oracle.questionHint'}}">
  </div>
  <div class="form-group">
    <label>{{localize "D2.Oracle.likelihood"}}</label>
    <select name="mode">
      <option value="normal">{{localize "D2.Oracle.normal"}}</option>
      <option value="likely">{{localize "D2.Oracle.likely"}}</option>
      <option value="unlikely">{{localize "D2.Oracle.unlikely"}}</option>
    </select>
  </div>
</div>
